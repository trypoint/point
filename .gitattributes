# Git attributes for Composer distribution

# Exclude development-only files from distribution package
/.github                export-ignore
/.codex                 export-ignore
/.kilo                  export-ignore
/.opencode              export-ignore
/.phpunit.cache         export-ignore
/.phpstorm.meta.php     export-ignore
/.cs.php                export-ignore
/AGENTS.md              export-ignore
/START-HERE.md          export-ignore
/PHASE1_REPORT.md       export-ignore
/phpstan.neon           export-ignore
/phpunit.xml            export-ignore
/.gitignore             export-ignore
/.gitattributes         export-ignore
/CONTRIBUTING.md        export-ignore

# Exclude test files
/tests                  export-ignore

# Keep the migration guide linked from the packaged README.
/docs/*                 export-ignore
/docs/migration-from-slim.md -export-ignore

# Exclude examples
/examples               export-ignore
